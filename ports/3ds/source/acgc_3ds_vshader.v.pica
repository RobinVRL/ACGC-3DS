; GX-style position and primary color path for the 3DS GX bridge.
.fvec projection[4]
.fvec modelview[4]
.constf constants(0.0, 1.0, 0.0, 0.0)
.alias one constants.yyyy
.out outpos position
.out outclr color
.out outtex texcoord0
.out outtex1 texcoord1
.alias inpos v0
.alias intex v1
.alias intex1 v2
.alias inclr v3
.proc main
    mov r0.xyz, inpos
    mov r0.w, one
    dp4 r1.x, modelview[0], r0
    dp4 r1.y, modelview[1], r0
    dp4 r1.z, modelview[2], r0
    dp4 r1.w, modelview[3], r0
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1
    mov outtex, intex
    mov outtex1, intex1
    mov outclr, inclr
    end
.end
